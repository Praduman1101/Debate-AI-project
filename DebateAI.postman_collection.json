{
  "info": {
    "name": "DebateAI API",
    "description": "Complete API collection for the DebateAI backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('token', json.token);",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Has token', () => pm.expect(json.token).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('token', json.token);",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/me",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has user', () => pm.expect(pm.response.json().user).to.be.an('object'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/auth/profile",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newusername\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Topics",
      "item": [
        {
          "name": "Get All Topics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/topics",
              "query": [
                {
                  "key": "category",
                  "value": "technology",
                  "disabled": true
                },
                {
                  "key": "difficulty",
                  "value": "intermediate",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "AI",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has topics array', () => pm.expect(pm.response.json().topics).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Topic by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/topics/{{topic_id}}"
          }
        },
        {
          "name": "Generate AI Topics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/topics/generate",
              "query": [
                {
                  "key": "category",
                  "value": "technology"
                },
                {
                  "key": "count",
                  "value": "3"
                }
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Debates",
      "item": [
        {
          "name": "Get Debate History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/debates",
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "completed",
                  "disabled": true
                }
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Get Debate Detail",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/debates/{{debate_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Delete Debate",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/debates/{{debate_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Get Leaderboard",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/debates/stats/leaderboard"
          }
        }
      ]
    },
    {
      "name": "Scores",
      "item": [
        {
          "name": "Get My Stats",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/scores/me",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has stats', () => pm.expect(pm.response.json().stats).to.be.an('object'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Finalize Debate Score",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/scores/finalize/{{debate_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Voice",
      "item": [
        {
          "name": "Transcribe Audio",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/voice/transcribe",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "audio",
                  "type": "file",
                  "src": "/path/to/audio.m4a"
                },
                {
                  "key": "topic",
                  "value": "AI is beneficial",
                  "type": "text"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/../health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('OK status', () => pm.expect(pm.response.json().status).to.equal('OK'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Bulk Create Topics",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/admin/topics/bulk",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topics\": [\n    {\n      \"title\": \"AI should replace all white-collar jobs\",\n      \"category\": \"technology\",\n      \"difficulty\": \"expert\",\n      \"trending\": false\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Topic",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/admin/topics/{{topic_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trending\": true,\n  \"featured\": true\n}"
            }
          }
        },
        {
          "name": "Delete Topic",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/admin/topics/{{topic_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    }
  ]
}