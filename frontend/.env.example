# ============================================================
# DebateAI Frontend — Expo Environment Variables
# Copy to .env and fill in your values
# Variables must be prefixed with EXPO_PUBLIC_ to be available in the app
# ============================================================

# Backend API base URL (no trailing slash)
# Local dev:   http://localhost:5000/api
# Production:  https://your-railway-app.railway.app/api
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# WebSocket server URL (no /api suffix)
# Local dev:   http://localhost:5000
# Production:  https://your-railway-app.railway.app
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000

# OpenAI key for client-side Whisper (optional — leave empty to use backend transcription)
# Recommended: leave empty and use the backend /api/voice/transcribe endpoint instead
EXPO_PUBLIC_OPENAI_KEY=
