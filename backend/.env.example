# ============================================================
# DebateAI Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB
# Local:  mongodb://localhost:27017/debate_ai
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/debate_ai
MONGODB_URI=mongodb://localhost:27017/debate_ai

# JWT Authentication
JWT_SECRET=replace_this_with_a_long_random_string_at_least_32_chars
JWT_EXPIRE=7d

# Anthropic Claude API (required — AI arguments, scoring, feedback)
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI Whisper API (optional — voice input transcription only)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here
